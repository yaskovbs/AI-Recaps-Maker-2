{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },

  "build": {

    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "image": "latest"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true,
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "NODE_ENV": "development",
        "GRADLE_OPTS": "-Xmx3072m -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8"
      }
    },

    "Development": {
      "extends": "development"
    },

    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease --stacktrace",
        "image": "latest"
      },
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false,
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "NODE_ENV": "production",
        "GRADLE_OPTS": "-Xmx512m"
      }
    },

    "preview-simulator": {
      "extends": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },

    "production": {
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "image": "latest"
      },
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false,
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "NODE_ENV": "production"
      }
    },

    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "NODE_ENV": "production",
        "GRADLE_OPTS": "-Xmx3072m -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8"
      }
    },

    "production-aab": {
      "extends": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "image": "latest"
      }
    },

    "production-ios": {
      "extends": "production",
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false
      }
    }

  },

  "submit": {

    "preview": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },

    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }

  }
}
